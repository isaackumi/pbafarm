# Convex (required)
NEXT_PUBLIC_CONVEX_URL=https://vibrant-stork-860.convex.site
NEXT_PUBLIC_CONVEX_SITE_URL=https://vibrant-stork-860.convex.site
NEXT_PUBLIC_APP_NAME=Fish Farm Management

# Assistant LLM keys (server-side — preferred, not exposed to the browser)
GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_BASE_URL=   # only read from the server env, never from the browser

# Optional default provider when multiple keys are set
LLM_DEFAULT_PROVIDER=gemini

# Optional browser-exposed keys (less secure — use only for local experiments)
# NEXT_PUBLIC_GEMINI_API_KEY=

# Error monitoring (OPS-001, optional; unset = no-op). Browser DSN is baked in at build.
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_APP_ENV=production   # tags browser reports; defaults to the Vercel env
# Convex deployment env (set with `npx convex env set`, not here): SENTRY_DSN, SENTRY_ENVIRONMENT

# Cloudflare R2 file storage (CF-005/006, optional; Convex deployment env, not Vercel).
# All four set = new attachments go to R2; unset = Convex storage (docs/ops/r2-storage.md):
#   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET, [R2_ENDPOINT]
#   FILES_PROVIDER=convex   # optional: keep new uploads on Convex even with R2 set

# Human check (Cloudflare Turnstile, CF-003). Set both or neither; unset = no check.
# Sign-up/reset always; password sign-in after 3 failures for an email.
# Browser (Next.js) site key:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Convex deployment env (npx convex env set …), never in the browser:
#   TURNSTILE_SECRET_KEY=
#   TURNSTILE_ALLOWED_HOSTNAMES=app.example.com,www.example.com   # optional

# Single sign-on (generic OIDC, ENT-003). Unset = no SSO button / provider.
# Browser label for the button (must match AUTH_OIDC_NAME):
# NEXT_PUBLIC_AUTH_OIDC_NAME=Company SSO
# Convex deployment env:
#   AUTH_OIDC_ISSUER=https://login.example.com     # OIDC discovery issuer
#   AUTH_OIDC_ID=
#   AUTH_OIDC_SECRET=
#   AUTH_OIDC_NAME=Company SSO                     # optional
# Register the redirect URI <CONVEX_SITE_URL>/api/auth/callback/oidc at the IdP.

# Authenticator-app MFA (ENT-003) stores TOTP secrets encrypted with the
# Convex env INTEGRATIONS_ENCRYPTION_KEY; without it the option is hidden.

# Platform console (PLAT-101, docs/ops/platform-console-dns.md). Comma-separated hosts that
# serve only /platform/** (plus sign-in pages); on any other host /platform/** is a 404.
# Default: console.heitechinc.com,console.localhost (dev: http://console.localhost:3000/platform).
# NEXT_PUBLIC_PLATFORM_CONSOLE_HOST=console.heitechinc.com,console.localhost
# Tenant app origin, opened after starting read-only support access from the console:
# NEXT_PUBLIC_TENANT_APP_URL=https://app.heitechinc.com
# Billing (Convex deployment env, npx convex env set …):
#   BILLING_GRACE_DAYS=7                 # days past due before automatic suspension
#   BILLING_PAYMENT_INSTRUCTIONS="Pay to MoMo 024… / bank … with the invoice number as reference"
# Contact address on the suspended-workspace page ("Contact support" is hidden when unset)
# NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
