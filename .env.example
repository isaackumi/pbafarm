# Convex (required)
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_APP_NAME=Fish Farm Management

# Assistant LLM keys (server-side — preferred, not exposed to the browser)
GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_BASE_URL=

# Optional default provider when multiple keys are set
LLM_DEFAULT_PROVIDER=gemini

# Optional browser-exposed keys (less secure — use only for local experiments)
# NEXT_PUBLIC_GEMINI_API_KEY=
